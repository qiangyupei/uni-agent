+    def _get_trajectory_postprocessor(self) -> TrajectoryPostprocessor | None:
+        """Load and cache the configured postprocessor on first use."""
+        if self._trajectory_postprocessor_fqn is None:
+            return None
+        if self._trajectory_postprocessor is None:
+            fqn = self._trajectory_postprocessor_fqn
+            try:
+                candidate = load_class_from_fqn(fqn, description="trajectory postprocessor")
+            except Exception as exc:
+                raise RuntimeError(f"Failed to load trajectory postprocessor {fqn!r}") from exc
+            if not callable(candidate):
+                raise TypeError(f"Trajectory postprocessor {fqn!r} must resolve to a callable")
+            self._trajectory_postprocessor = cast(TrajectoryPostprocessor, candidate)
+        return self._trajectory_postprocessor
+
+    async def _apply_trajectory_postprocessor(
+        self,
+        trajectories: list[Trajectory],
+        *,
+        context: TrajectoryPostprocessorContext,
+    ) -> list[Trajectory]:
+        """Apply the optional sync/async postprocessor and validate its result."""
+        processor = self._get_trajectory_postprocessor()
+        if processor is None:
+            return trajectories
+
+        fqn = self._trajectory_postprocessor_fqn
+        try:
+            result = processor(tuple(trajectories), context=context)
+            if inspect.isawaitable(result):
+                result = await result
+        except Exception as exc:
+            raise RuntimeError(f"Trajectory postprocessor {fqn!r} failed for session {context.session_id!r}") from exc
+
+        if not isinstance(result, list):
+            raise TypeError(
+                f"Trajectory postprocessor {fqn!r} must return list[Trajectory], got {type(result).__name__}"
+            )
+        for index, trajectory in enumerate(result):
+            if not isinstance(trajectory, Trajectory):
+                raise TypeError(
+                    f"Trajectory postprocessor {fqn!r} returned a non-Trajectory item "
+                    f"at index {index}: {type(trajectory).__name__}"
+                )
+        return result
