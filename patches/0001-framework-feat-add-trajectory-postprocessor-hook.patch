+"""Public contract for postprocessing finalized Gateway trajectories."""
+
+from __future__ import annotations
+
+from collections.abc import Awaitable, Mapping, Sequence
+from dataclasses import dataclass
+from typing import Protocol
+
+from uni_agent.gateway.session import Trajectory
+
+
+@dataclass(frozen=True)
+class TrajectoryPostprocessorContext:
+    """Read-only session context passed to a trajectory postprocessor.
+
+    ``sample_fields`` is the sample metadata extracted from the input batch. Its
+    top-level mapping is read-only; values retain their original types.
+    ``options`` is a deeply read-only, JSON-like copy of the configured
+    ``trajectory_postprocessor_kwargs``.
+    """
+
+    session_id: str
+    runner_name: str
+    sample_index: int
+    session_index: int
+    partition_id: str
+    global_steps: int | None
+    sample_fields: Mapping[str, object]
+    options: Mapping[str, object]
+
+
+class TrajectoryPostprocessor(Protocol):
+    """Callable contract for filtering or transforming finalized trajectories.
+
+    Implementations receive an immutable sequence container and must return a
+    concrete ``list[Trajectory]``. A synchronous result is consumed directly;
+    an awaitable result is awaited by the Framework. Synchronous processors run
+    on the Framework event loop and therefore must not perform blocking I/O.
+    """
+
+    def __call__(
+        self,
+        trajectories: Sequence[Trajectory],
+        *,
+        context: TrajectoryPostprocessorContext,
+    ) -> list[Trajectory] | Awaitable[list[Trajectory]]: ...
