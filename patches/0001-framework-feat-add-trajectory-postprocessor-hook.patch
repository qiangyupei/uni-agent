+def _recording_trajectory_postprocessor(trajectories, *, context):
+    _POSTPROCESSOR_CALLS.append({"trajectories": trajectories, "context": context})
+    return list(reversed(trajectories))
+
+
+async def _async_trajectory_postprocessor(trajectories, *, context):
+    await asyncio.sleep(0)
+    return list(trajectories[-1:])
+
+
+def _ordered_trajectory_postprocessor(trajectories, *, context):
+    _POSTPROCESSOR_EVENTS.append("postprocess")
+    return list(trajectories)
+
+
+def _tuple_trajectory_postprocessor(trajectories, *, context):
+    return tuple(trajectories)
+
+
+def _invalid_item_trajectory_postprocessor(trajectories, *, context):
+    return ["not-a-trajectory"]
+
+
+def _raising_trajectory_postprocessor(trajectories, *, context):
+    raise ValueError("recipe policy failed")
 
 
