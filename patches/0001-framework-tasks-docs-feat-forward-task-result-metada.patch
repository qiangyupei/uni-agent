+    conflicting_keys = sorted(_REWARD_INFO_RESERVED_KEYS.intersection(extra_info))
+    if conflicting_keys:
+        logger.warning(
+            "ignoring reserved TaskResult.extra_info keys: %s",
+            ", ".join(conflicting_keys),
+        )
+    forwarded_extra_info = {key: value for key, value in extra_info.items() if key not in _REWARD_INFO_RESERVED_KEYS}
+    if not forwarded_extra_info:
+        return reward_info
+
+    try:
+        _validate_extra_info_nesting(forwarded_extra_info)
+        serialized = json.dumps(forwarded_extra_info, allow_nan=False)
+    except (TypeError, ValueError, OverflowError) as exc:
+        if strict:
+            raise ValueError(
+                "TaskResult.extra_info must be JSON serializable "
+                f"with at most {MAX_TASK_RESULT_EXTRA_INFO_DEPTH} nested containers: {exc}"
+            ) from exc
+        logger.warning(
+            "omitting TaskResult.extra_info from reward_info: metadata must be JSON serializable "
+            "with at most %d nested containers (%s: %s)",
+            MAX_TASK_RESULT_EXTRA_INFO_DEPTH,
+            type(exc).__name__,
+            exc,
+        )
+        return reward_info
+
+    serialized_bytes = len(serialized.encode("utf-8"))
+    if serialized_bytes > MAX_TASK_RESULT_EXTRA_INFO_BYTES:
+        if strict:
+            raise ValueError(
+                f"TaskResult.extra_info is {serialized_bytes} serialized bytes; "
+                f"limit is {MAX_TASK_RESULT_EXTRA_INFO_BYTES} bytes"
+            )
+        logger.warning(
+            "omitting TaskResult.extra_info from reward_info: serialized metadata is %d bytes; limit is %d bytes",
+            serialized_bytes,
+            MAX_TASK_RESULT_EXTRA_INFO_BYTES,
+        )
+        return reward_info
+
+    reward_info.update(forwarded_extra_info)
     return reward_info
+
+
+def _validate_extra_info_nesting(value: Any, *, depth: int = 1, active_containers: set[int] | None = None) -> None:
+    """Reject cyclic or excessively nested JSON containers before serialization."""
+    if not isinstance(value, dict | list | tuple):
+        return
+    if depth > MAX_TASK_RESULT_EXTRA_INFO_DEPTH:
+        raise ValueError(f"metadata nesting depth exceeds {MAX_TASK_RESULT_EXTRA_INFO_DEPTH}")
+
+    if active_containers is None:
+        active_containers = set()
+    container_id = id(value)
+    if container_id in active_containers:
+        raise ValueError("metadata contains a circular reference")
+
+    active_containers.add(container_id)
+    try:
+        if isinstance(value, dict):
+            for key in value:
+                if not isinstance(key, str):
+                    raise TypeError(f"metadata object keys must be strings, got {type(key).__name__}")
+            children = value.values()
+        else:
+            children = value
+        for child in children:
+            _validate_extra_info_nesting(child, depth=depth + 1, active_containers=active_containers)
+    finally:
+        active_containers.remove(container_id)
