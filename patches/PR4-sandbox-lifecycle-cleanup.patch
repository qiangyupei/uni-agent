 _startup_semaphores: weakref.WeakKeyDictionary = weakref.WeakKeyDictionary()
@@ -211,6 +213,12 @@ def _env_number(name: str, default: float) -> float:
         return default
 
 
+def _stop_timeout() -> float:
+    """Return the timeout for lifecycle-owned ``stop()`` calls."""
+    timeout = _env_number("SANDBOX_STOP_TIMEOUT", _DEFAULT_STOP_TIMEOUT)
+    return timeout if timeout > 0 and math.isfinite(timeout) else _DEFAULT_STOP_TIMEOUT
+
+
 @asynccontextmanager
 async def _startup_slot() -> AsyncIterator[None]:
     """Hold one shared startup slot for the running loop (a no-op when ``<=0``).
@@ -295,12 +303,59 @@ class Sandbox(abc.ABC):
         except asyncio.TimeoutError as exc:
             raise TimeoutError(f"sandbox start() exceeded SANDBOX_STARTUP_TIMEOUT={timeout:g}s") from exc
 
+    @staticmethod
+    def _consume_stop_result(task: asyncio.Task[None]) -> None:
+        """Consume the result of a stop task that outlived its lifecycle call."""
+        try:
+            task.result()
+        except asyncio.CancelledError:
+            pass
+        except BaseException as exc:
+            logger.error("sandbox stop() failed after timeout", exc_info=(type(exc), exc, exc.__traceback__))
+
+    async def _bounded_stop(self) -> None:
+        """Run ``stop()`` for at most ``SANDBOX_STOP_TIMEOUT`` seconds.
+
+        Waiting on the provider task explicitly keeps the deadline hard even if
+        the provider suppresses cancellation.
+        """
+        timeout = _stop_timeout()
+        stop_task = asyncio.create_task(self.stop())
+        done, _ = await asyncio.wait({stop_task}, timeout=timeout)
+        if stop_task not in done:
+            stop_task.cancel()
+            stop_task.add_done_callback(self._consume_stop_result)
+            raise TimeoutError(f"sandbox stop() exceeded SANDBOX_STOP_TIMEOUT={timeout:g}s")
+        await stop_task
+
+    async def _run_stop(self) -> None:
+        """Shield bounded cleanup, then propagate cancellation or cleanup failure.
+
+        Caller cancellation is delayed until ``stop()`` finishes or reaches its
+        own bound. A cleanup failure still takes precedence over cancellation.
+        """
+        cleanup_task = asyncio.create_task(self._bounded_stop())
+        cancellation: asyncio.CancelledError | None = None
+
+        while not cleanup_task.done():
+            try:
+                await asyncio.shield(cleanup_task)
+            except asyncio.CancelledError as exc:
+                if cleanup_task.cancelled():
+                    raise
+                cancellation = cancellation or exc
+
+        await cleanup_task
+        if cancellation is not None:
+            raise cancellation
+
     async def __aenter__(self, retry: int = 3) -> Sandbox:
         """Create the sandbox (retrying transient ``start()`` failures) and return it ready.
 
         Each attempt holds one startup slot (``SANDBOX_STARTUP_CONCURRENCY``)
         and is bounded by ``SANDBOX_STARTUP_TIMEOUT``; the slot is released before the
-        retry backoff and the cleanup ``stop()``.
+        retry backoff and the cleanup ``stop()``. A retry is attempted only after
+        cleanup succeeds.
         """
         retry = max(1, retry)
         last_exc: BaseException | None = None
@@ -309,12 +364,11 @@ class Sandbox(abc.ABC):
                 async with _startup_slot():
                     await self._run_start()
                 return self
-            except Exception as exc:
