index 0000000..45ba3c8
--- /dev/null
+++ b/tests/uni_agent/sandbox/test_lifecycle_cleanup.py
@@ -0,0 +1,294 @@
+from __future__ import annotations
+
+import asyncio
+import time
+from collections.abc import Awaitable, Callable
+from types import SimpleNamespace
+
+import pytest
+
+from uni_agent.sandbox.base import ExecResult, Sandbox
+
+
+class _LifecycleSandbox(Sandbox):
+    def __init__(
+        self,
+        *,
+        start_impl: Callable[[], Awaitable[None]] | None = None,
+        stop_impl: Callable[[], Awaitable[None]] | None = None,
+    ) -> None:
+        self.start_impl = start_impl
+        self.stop_impl = stop_impl
+        self.start_calls = 0
+        self.stop_calls = 0
+
+    async def start(self) -> None:
+        self.start_calls += 1
+        if self.start_impl is not None:
+            await self.start_impl()
+
+    async def stop(self) -> None:
+        self.stop_calls += 1
+        if self.stop_impl is not None:
+            await self.stop_impl()
+
+    async def _exec(self, argv, *, timeout=None, workdir=None, env=None) -> ExecResult:
+        return ExecResult(exit_code=0, stdout="", stderr="")
+
+
+def test_context_success_starts_and_stops_once() -> None:
+    sandbox = _LifecycleSandbox()
+
+    async def run() -> None:
+        async with sandbox as entered:
+            assert entered is sandbox
+
+    asyncio.run(run())
+    assert sandbox.start_calls == 1
+    assert sandbox.stop_calls == 1
+
+
+def test_stop_failure_is_chained_from_body_error() -> None:
+    class BodyError(RuntimeError):
+        pass
+
+    class StopError(RuntimeError):
+        pass
+
+    async def fail_stop() -> None:
+        raise StopError("cleanup failed")
+
+    sandbox = _LifecycleSandbox(stop_impl=fail_stop)
+
+    async def run() -> None:
+        async with sandbox:
+            raise BodyError("episode failed")
+
+    with pytest.raises(StopError, match="cleanup failed") as exc_info:
+        asyncio.run(run())
+
+    assert isinstance(exc_info.value.__cause__, BodyError)
+    assert sandbox.stop_calls == 1
+
+
+@pytest.mark.parametrize("use_entered", [False, True], ids=["dunder-context", "entered-context"])
+def test_cleanup_is_shielded_when_caller_is_cancelled(use_entered: bool) -> None:
+    stop_started: asyncio.Event
+    release_stop: asyncio.Event
+    stop_was_cancelled = False
+    stopped = False
+
+    async def run() -> None:
+        nonlocal stop_started, release_stop, stop_was_cancelled, stopped
+        stop_started = asyncio.Event()
+        release_stop = asyncio.Event()
+
+        async def stop() -> None:
+            nonlocal stop_was_cancelled, stopped
+            stop_started.set()
+            try:
+                await release_stop.wait()
+            except asyncio.CancelledError:
+                stop_was_cancelled = True
+                raise
+            stopped = True
+
+        sandbox = _LifecycleSandbox(stop_impl=stop)
+
+        async def use_sandbox() -> None:
+            if use_entered:
+                async with sandbox.entered():
+                    pass
+            else:
+                async with sandbox:
+                    pass
+
+        task = asyncio.create_task(use_sandbox())
+        await stop_started.wait()
+        task.cancel()
+        await asyncio.sleep(0)
+        assert not task.done()
+        assert not stop_was_cancelled
+        task.cancel()
+        await asyncio.sleep(0)
+        assert not task.done()
+        assert not stop_was_cancelled
+
+        release_stop.set()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+
+        assert stopped
+        assert not stop_was_cancelled
+        assert sandbox.stop_calls == 1
+
+    asyncio.run(run())
+
+
+def test_stop_failure_wins_over_cancellation_with_explicit_chain() -> None:
+    class StopError(RuntimeError):
+        pass
+
+    async def run() -> None:
+        stop_started = asyncio.Event()
+        release_stop = asyncio.Event()
+
+        async def stop() -> None:
+            stop_started.set()
+            await release_stop.wait()
+            raise StopError("remote kill failed")
+
+        sandbox = _LifecycleSandbox(stop_impl=stop)
+
+        async def use_sandbox() -> None:
+            async with sandbox:
+                pass
+
+        task = asyncio.create_task(use_sandbox())
+        await stop_started.wait()
+        task.cancel()
+        release_stop.set()
+
+        with pytest.raises(StopError, match="remote kill failed") as exc_info:
+            await task
+        assert isinstance(exc_info.value.__cause__, asyncio.CancelledError)
+
+    asyncio.run(run())
+
+
+def test_stop_timeout_is_a_hard_bound_even_if_stop_suppresses_cancellation(monkeypatch) -> None:
+    monkeypatch.setenv("SANDBOX_STOP_TIMEOUT", "0.02")
+
+    async def run() -> tuple[float, bool]:
+        cancellation_seen = asyncio.Event()
+        release_stop = asyncio.Event()
+
+        async def stubborn_stop() -> None:
+            try:
+                await asyncio.Event().wait()
+            except asyncio.CancelledError:
+                cancellation_seen.set()
+                await release_stop.wait()
+
+        sandbox = _LifecycleSandbox(stop_impl=stubborn_stop)
+        started = time.monotonic()
+        try:
+            with pytest.raises(TimeoutError, match=r"SANDBOX_STOP_TIMEOUT=0\.02s"):
+                async with sandbox:
+                    pass
+        finally:
+            release_stop.set()
+            await asyncio.sleep(0)
+        return time.monotonic() - started, cancellation_seen.is_set()
+
+    elapsed, stop_was_cancelled = asyncio.run(run())
+    assert stop_was_cancelled
+    assert elapsed < 0.5
+
+
+def test_start_cleanup_failure_stops_retries_and_preserves_error_chain() -> None:
+    class StartError(RuntimeError):
+        pass
+
+    class StopError(RuntimeError):
+        pass
+
+    async def fail_first_start() -> None:
+        if sandbox.start_calls == 1:
+            raise StartError("partial start")
+
+    async def fail_stop() -> None:
+        raise StopError("could not clean partial sandbox")
+
+    sandbox = _LifecycleSandbox(start_impl=fail_first_start, stop_impl=fail_stop)
+
+    with pytest.raises(StopError, match="could not clean") as exc_info:
+        asyncio.run(sandbox.__aenter__(retry=3))
+
+    assert isinstance(exc_info.value.__cause__, StartError)
+    assert sandbox.start_calls == 1
+    assert sandbox.stop_calls == 1
+
+
+def test_start_cancellation_cleans_up_without_retry() -> None:
+    async def run() -> tuple[int, int]:
+        start_blocked = asyncio.Event()
+        stop_finished = asyncio.Event()
+
+        async def start() -> None:
+            start_blocked.set()
+            await asyncio.Event().wait()
+
+        async def stop() -> None:
+            await asyncio.sleep(0)
+            stop_finished.set()
+
+        sandbox = _LifecycleSandbox(start_impl=start, stop_impl=stop)
+        task = asyncio.create_task(sandbox.__aenter__(retry=3))
+        await start_blocked.wait()
+        task.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+        assert stop_finished.is_set()
+        return sandbox.start_calls, sandbox.stop_calls
+
+    assert asyncio.run(run()) == (1, 1)
+
+
+def test_openyuanrong_stop_failure_keeps_handle_and_can_retry() -> None:
+    from uni_agent.sandbox.openyuanrong import OpenyuanrongSandbox
+
+    class Backend:
+        sandbox_id = "sandbox-123"
+
+        def __init__(self) -> None:
+            self.kill_calls = 0
+
+        def kill(self) -> None:
+            self.kill_calls += 1
+            if self.kill_calls == 1:
+                raise RuntimeError("provider unavailable")
+
+    backend = Backend()
+    sandbox = OpenyuanrongSandbox(image="test-image")
+    sandbox._sandbox = backend
+
+    async def run() -> None:
+        with pytest.raises(RuntimeError, match="provider unavailable"):
+            await sandbox.stop()
+        assert sandbox._sandbox is backend
+
+        await sandbox.stop()
+        assert sandbox._sandbox is None
+
+    asyncio.run(run())
+    assert backend.kill_calls == 2
+
+
+def test_openyuanrong_runtime_timeout_is_not_forwarded_to_unknown_sdk(monkeypatch) -> None:
+    from uni_agent.sandbox import openyuanrong as openyuanrong_module
+
+    captured_kwargs: dict[str, object] = {}
+
+    class Backend:
+        def __init__(self, **kwargs) -> None:
+            captured_kwargs.update(kwargs)
+
+        def kill(self) -> None:
+            pass
+
+    sdk = SimpleNamespace(Sandbox=Backend, Mount=object)
+    monkeypatch.setattr(openyuanrong_module, "_load_sandbox_module", lambda: sdk)
+    sandbox = openyuanrong_module.OpenyuanrongSandbox(
+        image="test-image",
+        runtime_timeout=17,
+        idle_timeout=23,
+    )
+
+    async def run() -> None:
+        await sandbox.start()
+        await sandbox.stop()
+
+    asyncio.run(run())
+    assert captured_kwargs["idle_timeout"] == 23
+    assert "runtime_timeout" not in captured_kwargs
