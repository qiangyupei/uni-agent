+def _freeze_json_like(value: object, *, path: str) -> object:
+    """Validate and deeply freeze a JSON-like configuration value."""
+    if value is None or isinstance(value, str | bool | int):
+        return value
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValueError(f"{path} must contain finite JSON numbers")
+        return value
+    if isinstance(value, list):
+        return tuple(_freeze_json_like(item, path=f"{path}[{index}]") for index, item in enumerate(value))
+    if isinstance(value, dict):
+        frozen: dict[str, object] = {}
+        for key, item in value.items():
+            if not isinstance(key, str):
+                raise ValueError(f"{path} keys must be strings, got {type(key).__name__}")
+            frozen[key] = _freeze_json_like(item, path=f"{path}.{key}")
+        return MappingProxyType(frozen)
+    raise ValueError(f"{path} must be JSON-like, got {type(value).__name__}")
+
