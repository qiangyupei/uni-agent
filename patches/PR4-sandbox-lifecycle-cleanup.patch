diff --git a/docs/source/concepts/sandbox.md b/docs/source/concepts/sandbox.md
index 6994ef1..8a11e2e 100644
--- a/docs/source/concepts/sandbox.md
+++ b/docs/source/concepts/sandbox.md
@@ -58,12 +58,19 @@ async with sandbox:
     result = await sandbox.exec_shell("python --version")
 ```
 
-Entering the context starts the backend with retry, timeout, and global startup-concurrency controls. Exiting the context calls `stop()` even when the episode raises.
+Entering the context starts the backend with retry, timeout, and global
+startup-concurrency controls. Exiting the context calls `stop()` even when the
+episode raises or the caller is cancelled.
 
 The shared lifecycle uses:
 
 - `SANDBOX_STARTUP_TIMEOUT`: startup timeout, 600 seconds by default.
 - `SANDBOX_STARTUP_CONCURRENCY`: process-wide startup limit, 64 by default.
+- `SANDBOX_STOP_TIMEOUT`: lifecycle cleanup timeout, 60 seconds by default.
+
+Lifecycle cleanup is shielded from cancellation and bounded by the stop timeout.
+A failed startup is retried only after its cleanup succeeds. Process-level hard
+kills cannot run Python cleanup, so remote providers still need a TTL or reaper.
 
 Remote providers should implement `is_alive()` as a non-throwing health probe.
 
@@ -148,6 +155,8 @@ The module is imported only when the provider is selected, so optional SDKs do n
 
 - Implement `_exec()`, not `exec()`.
 - Make `start()` and `stop()` safe to call during partial failures.
+- Do not discard provider handles until remote termination succeeds, so a
+  failed `stop()` remains retryable.
 - Override `is_alive()` for remote providers.
 - Extend `_is_timeout_error()` when the provider SDK uses custom timeout exceptions.
 - Preserve `stdout`, `stderr`, and exit codes in `ExecResult`.
diff --git a/tests/uni_agent/sandbox/test_lifecycle_cleanup.py b/tests/uni_agent/sandbox/test_lifecycle_cleanup.py
new file mode 100644
index 0000000..d2ed7a0
--- /dev/null
+++ b/tests/uni_agent/sandbox/test_lifecycle_cleanup.py
@@ -0,0 +1,157 @@
+from __future__ import annotations
+
+import asyncio
+from collections.abc import Awaitable, Callable
+
+import pytest
+
+from uni_agent.sandbox.base import ExecResult, Sandbox
+
+
+class _LifecycleSandbox(Sandbox):
+    def __init__(
+        self,
+        *,
+        start_impl: Callable[[], Awaitable[None]] | None = None,
+        stop_impl: Callable[[], Awaitable[None]] | None = None,
+    ) -> None:
+        self.start_impl = start_impl
+        self.stop_impl = stop_impl
+        self.start_calls = 0
+        self.stop_calls = 0
+
+    async def start(self) -> None:
+        self.start_calls += 1
+        if self.start_impl is not None:
+            await self.start_impl()
+
+    async def stop(self) -> None:
+        self.stop_calls += 1
+        if self.stop_impl is not None:
+            await self.stop_impl()
+
+    async def _exec(self, argv, *, timeout=None, workdir=None, env=None) -> ExecResult:
+        return ExecResult(exit_code=0, stdout="", stderr="")
+
+
+def test_context_cleanup_survives_cancellation() -> None:
+    async def assert_cleanup(use_entered: bool) -> None:
+        stop_started = asyncio.Event()
+        release_stop = asyncio.Event()
+        stopped = False
+
+        async def stop() -> None:
+            nonlocal stopped
+            stop_started.set()
+            await release_stop.wait()
+            stopped = True
+
+        sandbox = _LifecycleSandbox(stop_impl=stop)
+
+        async def use_sandbox() -> None:
+            context = sandbox.entered() if use_entered else sandbox
+            async with context:
+                pass
+
+        task = asyncio.create_task(use_sandbox())
+        await stop_started.wait()
+        task.cancel()
+        await asyncio.sleep(0)
+        assert not task.done()
+
+        release_stop.set()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+        assert stopped
+        assert sandbox.stop_calls == 1
+
+    async def run() -> None:
+        await assert_cleanup(False)
+        await assert_cleanup(True)
+
+    asyncio.run(run())
+
+
+def test_stop_timeout_is_hard_bound(monkeypatch) -> None:
+    monkeypatch.setenv("SANDBOX_STOP_TIMEOUT", "0.01")
+
+    async def run() -> None:
+        release_stop = asyncio.Event()
+
+        async def stubborn_stop() -> None:
+            try:
+                await asyncio.Event().wait()
+            except asyncio.CancelledError:
+                await release_stop.wait()
+
+        sandbox = _LifecycleSandbox(stop_impl=stubborn_stop)
+        try:
+            with pytest.raises(TimeoutError, match="SANDBOX_STOP_TIMEOUT"):
+                await asyncio.wait_for(sandbox.__aexit__(None, None, None), timeout=0.5)
+        finally:
+            release_stop.set()
+            await asyncio.sleep(0)
+
+    asyncio.run(run())
+
+
+def test_start_cancellation_cleans_up_without_retry() -> None:
+    async def run() -> tuple[int, int]:
+        start_blocked = asyncio.Event()
+
+        async def start() -> None:
+            start_blocked.set()
+            await asyncio.Event().wait()
+
+        sandbox = _LifecycleSandbox(start_impl=start)
+        task = asyncio.create_task(sandbox.__aenter__(retry=3))
+        await start_blocked.wait()
+        task.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+        return sandbox.start_calls, sandbox.stop_calls
+
+    assert asyncio.run(run()) == (1, 1)
+
+
+def test_failed_start_cleanup_prevents_retry() -> None:
+    async def fail_start() -> None:
+        raise RuntimeError("partial start")
+
+    async def fail_stop() -> None:
+        raise RuntimeError("cleanup failed")
+
+    sandbox = _LifecycleSandbox(start_impl=fail_start, stop_impl=fail_stop)
+    with pytest.raises(RuntimeError, match="cleanup failed"):
+        asyncio.run(sandbox.__aenter__(retry=3))
+    assert (sandbox.start_calls, sandbox.stop_calls) == (1, 1)
+
+
+def test_openyuanrong_stop_failure_keeps_handle_for_retry() -> None:
+    from uni_agent.sandbox.openyuanrong import OpenyuanrongSandbox
+
+    class Backend:
+        sandbox_id = "sandbox-123"
+
+        def __init__(self) -> None:
+            self.kill_calls = 0
+
+        def kill(self) -> None:
+            self.kill_calls += 1
+            if self.kill_calls == 1:
+                raise RuntimeError("provider unavailable")
+
+    async def run() -> None:
+        backend = Backend()
+        sandbox = OpenyuanrongSandbox(image="test-image")
+        sandbox._sandbox = backend
+
+        with pytest.raises(RuntimeError, match="provider unavailable"):
+            await sandbox.stop()
+        assert sandbox._sandbox is backend
+
+        await sandbox.stop()
+        assert sandbox._sandbox is None
+        assert backend.kill_calls == 2
+
+    asyncio.run(run())
