+    async def _run_stop(self) -> None:
+        """Shield bounded cleanup, then propagate cancellation or cleanup failure.
+
+        A caller cancellation is delayed until ``stop()`` finishes or reaches
+        its own bound.  If cleanup fails while cancellation is pending, the
+        cleanup error is raised with the cancellation chained as its cause so
+        resource-release failures are never hidden.
+        """
+        cleanup_task = asyncio.create_task(self._bounded_stop())
+        cancellation: asyncio.CancelledError | None = None
+
+        while not cleanup_task.done():
+            try:
+                await asyncio.shield(cleanup_task)
+            except asyncio.CancelledError as exc:
+                # A completed, non-cancelled child means this CancelledError
+                # came from the caller; remember it even in the completion
+                # race. A cancelled child is handled by task.result() below.
+                if cancellation is None and (not cleanup_task.done() or not cleanup_task.cancelled()):
