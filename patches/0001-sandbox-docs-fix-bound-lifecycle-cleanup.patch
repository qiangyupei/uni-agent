+    async def _bounded_stop(self) -> None:
+        """Run ``stop()`` for at most ``SANDBOX_STOP_TIMEOUT`` seconds.
+
+        ``asyncio.wait_for`` can itself wait forever when a provider suppresses
+        cancellation.  Waiting on the provider task explicitly keeps the
+        lifecycle boundary hard: after the deadline the task is cancelled and
+        observed in the background, while the caller receives ``TimeoutError``.
+        """
+        timeout = _stop_timeout()
+        stop_task = asyncio.create_task(self.stop())
+        try:
+            done, _ = await asyncio.wait({stop_task}, timeout=timeout)
+        except BaseException:
+            stop_task.cancel()
+            stop_task.add_done_callback(self._log_late_stop_outcome)
+            raise
+
+        if not done:
+            stop_task.cancel()
+            stop_task.add_done_callback(self._log_late_stop_outcome)
+            raise TimeoutError(f"sandbox stop() exceeded SANDBOX_STOP_TIMEOUT={timeout:g}s")
